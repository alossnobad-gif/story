server {
    listen 8443 ssl;
    server_name 123.57.60.66;
    ssl_certificate /etc/story-writing/tls/server.crt;
    ssl_certificate_key /etc/story-writing/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 8m;
    access_log /var/log/nginx/story-writing.access.log;
    error_log /var/log/nginx/story-writing.error.log;

    location / {
        auth_basic off;
        proxy_pass http://127.0.0.1:3101;
        # Keep :8443 for same-origin validation of authenticated writes.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}

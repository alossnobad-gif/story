[Unit]
Description=Story Writing Studio
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=story-writing
Group=story-writing
WorkingDirectory=/opt/story/current
EnvironmentFile=/etc/story-writing/story.env
ExecStart=/opt/story/runtime/bin/node --use-env-proxy --max-old-space-size=192 /opt/story/current/server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/story-writing
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=256M
MemoryMax=384M
CPUQuota=75%
Nice=10
TasksMax=64

[Install]
WantedBy=multi-user.target
